{
  "models": {
    "denoiser": {
      "name": "SparseStructureFlowModel",
      "args": {
        "resolution": 16,
        "in_channels": 8,
        "out_channels": 8,
        "model_channels": 512,
        "cond_channels": 1024,
        "num_blocks": 8,
        "num_heads": 8,
        "num_head_channels": 64,
        "mlp_ratio": 4,
        "patch_size": 2,
        "pe_mode": "ape",
        "use_fp16": false,
        "use_checkpoint": true,
        "voxel_cond_classes": 128,
        "voxel_cond_channels": 32,
        "voxel_cond_scale": 4
      }
    }
  },
  "dataset": {
    "name": "MCFlowImageDataset",
    "args": {
      "latent_npy": "/data/redstone_v4/train/ss_latent_all.npy",
      "image_dir": "/data/redstone_v4/render_all",
      "image_size": 518,
      "blocks_npy": "/data/redstone_v4/train/ss64_all.npy",
      "states_npy": "/data/redstone_v4/train/ss64_state_all.npy",
      "inpaint_probability": 0.3,
      "up_axis": 1,
      "normalize": {
        "mean": [
          0.19404340219107474,
          -0.024709202139835944,
          0.07804697838630725,
          -0.8640874714518587,
          -0.08131022435244678,
          0.13615294481099824,
          -0.3282934227388893,
          -0.060508971817526576
        ],
        "std": [
          3.8586817803836344,
          3.5028193317221277,
          3.724194294333513,
          5.672760242447846,
          3.26636135001524,
          3.928173486643692,
          3.7233724889945,
          2.930487391561616
        ]
      }
    }
  },
  "trainer": {
    "name": "DenseImageFlowMatchingCFGTrainer",
    "args": {
      "max_steps": 4,
      "batch_size_per_gpu": 4,
      "batch_split": 1,
      "optimizer": {
        "name": "AdamW",
        "args": {
          "lr": 5e-05,
          "weight_decay": 0.0
        }
      },
      "lr_scheduler": {
        "name": "CosineAnnealingLR",
        "args": {
          "T_max": 4,
          "eta_min": 0.0
        }
      },
      "ema_rate": [
        0.9999
      ],
      "fp16_mode": null,
      "fp16_scale_growth": 0.001,
      "grad_clip": {
        "name": "AdaptiveGradClipper",
        "args": {
          "max_norm": 1.0,
          "clip_percentile": 95
        }
      },
      "i_log": 1,
      "i_sample": 1000000,
      "i_save": 2,
      "p_uncond": 0.1,
      "inpaint_image_drop_probability": 0.25,
      "image_cond_model": "facebook/dinov2-large",
      "t_schedule": {
        "name": "logitNormal",
        "args": {
          "mean": 0.0,
          "std": 1.0
        }
      },
      "sigma_min": 1e-05,
      "finetune_ckpt": {
        "denoiser": "/data/redstone_v4/work/v4_init.pt"
      }
    }
  }
}