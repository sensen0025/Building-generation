                }
            },
            "i_log": 100,
            "i_sample": 1000000,
            "i_save": 2000,
            "p_uncond": 0.1,
            "image_cond_model": "facebook/dinov2-large",
            "t_schedule": {
                "name": "logitNormal",
                "args": {
                    "mean": 0.0,
                    "std": 1.0
                }
            },
            "sigma_min": 1e-05
        }
    }
