{
    "models": {
        "denoiser": {
            "name": "SparseStructureFlowModel",
            "args": {
                "resolution": 16,
                "in_channels": 8,
                "out_channels": 8,
                "model_channels": 512,
                "cond_channels": 1024,
                "num_blocks": 8,
                "num_heads": 8,
                "num_head_channels": 64,
                "mlp_ratio": 4,
                "patch_size": 2,
                "pe_mode": "ape",
                "use_fp16": true
            }
        }
    },
    "dataset": {
        "name": "MCFlowImageDataset",
        "args": {
            "latent_npy": "/home/linux/redstone_ai/dataset/ss_latent_mc64.npy",
            "image_dir": "/home/linux/redstone_ai/render_output",
            "image_size": 518,
            "normalize": {
                "mean": [
                    -0.172096,
                    -0.253491,
                    -0.464961,
                    -0.182004,
                    0.084891,
                    0.07631,
                    0.095924,
                    0.17365
                ],
                "std": [
                    0.845492,
                    0.816747,
                    1.224406,
                    0.872764,
                    0.942653,
                    0.81222,
                    0.820962,
                    0.76632
                ]
            }
        }
    },
    "trainer": {
        "name": "DenseImageFlowMatchingCFGTrainer",
        "args": {
            "max_steps": 200000,
            "batch_size_per_gpu": 8,
            "batch_split": 1,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 3e-05,
                    "weight_decay": 0.0
                }
            },
            "ema_rate": [
                0.9999
            ],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 100,
            "i_sample": 1000000,
            "i_save": 2000,
            "p_uncond": 0.1,
            "image_cond_model": "facebook/dinov2-large",
            "t_schedule": {
                "name": "logitNormal",
                "args": {
                    "mean": 0.0,
                    "std": 1.0
                }
            },
            "sigma_min": 1e-05
        }
    }
